{
  "$schema": "https://json.schemastore.org/package",
  "name": "barrelsmith",
  "version": "0.0.9",
  "description": "A barrel file generator",
  "author": "Fernando Coelho",
  "repository": "https://github.com/Fgc17/barrelsmith",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./dist/index.cjs"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.cts"
      ]
    }
  },
  "bin": {
    "barrelsmith": "dist/bin/cmd.cjs"
  },
  "scripts": {
    "lint": "biome lint --error-on-warnings",
    "format": "biome format --write",
    "build": "tsdown",
    "dev": "pnpm run build --watch",
    "change": "changeset",
    "bump": "changeset version",
    "release": "pnpm build && changeset version && changeset publish",
    "barrelsmith": "node dist/bin/cmd.cjs"
  },
  "dependencies": {
    "jiti": "2.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@changesets/cli": "2.30.0",
    "@types/node": "22.9.1",
    "@typescript/native-preview": "7.0.0-dev.20260305.1",
    "typescript": "5.9.3",
    "tsdown": "0.21.2"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=18"
  }
}
