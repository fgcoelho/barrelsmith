{
  "$schema": "https://json.schemastore.org/package",
  "name": "barrelsmith",
  "version": "0.0.9",
  "description": "A barrel file generator",
  "author": "Fernando Coelho",
  "repository": "https://github.com/Fgc17/barrelsmith",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "scripts": {
    "lint": "biome lint --error-on-warnings",
    "format": "biome format --write",
    "build": "rm -rf dist && tsgo",
    "dev": "pnpm run build --watch",
    "bump": "changeset",
    "release": "pnpm build && changeset version && changeset publish",
    "barrelsmith": "node dist/bin/cmd.js"
  },
  "bin": {
    "barrelsmith": "dist/bin/cmd.js"
  },
  "dependencies": {
    "jiti": "2.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@changesets/cli": "2.30.0",
    "@types/node": "22.9.1",
    "@typescript/native-preview": "7.0.0-dev.20260305.1"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=18"
  }
}
